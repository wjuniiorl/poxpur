    {
      "parameters": {
        "jsCode": "const orders = $('Pedidos do dia').first().json || [];\nconst settings = ($('Config empresa').first().json || [])[0] || {};\nif (!settings.recebe_resumo_diario || !settings.whatsapp_phone) {\n  return [{ json: { skip: true } }];\n}\nconst byStatus = orders.reduce((a, o) => { a[o.status] = (a[o.status] || 0) + 1; return a; }, {});\nconst fat = orders.filter(o => !['recusado','cancelado'].includes(o.status))\n  .reduce((s, o) => s + Number(o.valor_total || 0), 0);\nconst pend = orders.filter(o => o.status === 'pendente_aprovacao').length;\nconst awf = orders.filter(o => o.status === 'aguardando_fabrica').length;\nconst fmt = n => new Intl.NumberFormat('pt-BR', { style:'currency', currency:'BRL' }).format(n);\nconst hoje = new Date().toLocaleDateString('pt-BR');\nconst lines = [\n  `📊 *Resumo Poxpur — ${hoje}*`, '',\n  `Pedidos hoje: *${orders.length}*`, `Faturamento: *${fmt(fat)}*`, '', '*Por status:*',\n  ...Object.entries(byStatus).map(([s,c]) => `• ${s.replace(/_/g,' ')}: ${c}`)\n];\nif (pend > 0) lines.push('', `⚠️ *${pend} pedido(s) aguardando aprovação*`);\nif (awf > 0) lines.push(`🏭 *${awf} pedido(s) aguardando fábrica*`);\nlines.push('', '_Acesse o Sales Hub para ver detalhes._');\nreturn [{ json: { skip: false, phone: settings.whatsapp_phone.replace(/^\\+/,''), text: lines.join('\\n') } }];"
      },
