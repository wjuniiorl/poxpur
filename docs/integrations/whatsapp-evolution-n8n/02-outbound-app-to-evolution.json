{
  "name": "Poxpur — Outbound (App → Evolution)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "poxpur-whatsapp-outbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000001",
      "name": "Webhook do App",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "poxpur-whatsapp-outbound",
      "notes": "Cole esta URL (Production) no .env do app: VITE_N8N_OUTBOUND_WEBHOOK_URL=https://n8n.escritoriowl.xyz/webhook/poxpur-whatsapp-outbound. Body esperado: { messageId, conversationId, to, text }"
    },
    {
      "parameters": {
        "jsCode": "// Valida e prepara payload\nconst body = $input.first().json.body;\nif (!body.messageId || !body.to || !body.text) {\n  throw new Error('messageId, to e text são obrigatórios');\n}\n\n// Normaliza telefone removendo o + (Evolution usa formato sem +)\nconst phone = body.to.replace(/^\\+/, '');\n\nreturn [{\n  json: {\n    messageId: body.messageId,\n    conversationId: body.conversationId,\n    phone,\n    text: body.text\n  }\n}];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_BASE_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.phone }}\",\n  \"text\": {{ JSON.stringify($json.text) }}\n}",
        "options": {
          "timeout": 15000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000003",
      "name": "Enviar via Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Evolution API Key"
        }
      },
      "notes": "Credential HTTP Header Auth: name='apikey', value=<EVOLUTION_API_KEY>. neverError=true pra capturar falha sem quebrar o workflow."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "success-check",
              "leftValue": "={{ $json.key?.id || $json.messageId || null }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000004",
      "name": "Sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/messages?id=eq.{{ $('Validar entrada').item.json.messageId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept-Profile", "value": "poxpur" },
            { "name": "Content-Profile", "value": "poxpur" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"whatsapp_message_id\": \"{{ $json.key?.id || $json.messageId }}\",\n  \"metadata\": { \"status\": \"enviado\", \"sent_via\": \"evolution-n8n\", \"evolution_response\": {{ JSON.stringify($json) }} }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000005",
      "name": "PATCH messages (sucesso)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/messages?id=eq.{{ $('Validar entrada').item.json.messageId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Accept-Profile", "value": "poxpur" },
            { "name": "Content-Profile", "value": "poxpur" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"metadata\": { \"status\": \"erro\", \"sent_via\": \"evolution-n8n\", \"error\": {{ JSON.stringify($json) }} }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000006",
      "name": "PATCH messages (erro)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"sent\": true, \"messageId\": $('Validar entrada').item.json.messageId, \"whatsappMessageId\": ($('Enviar via Evolution').item.json.key?.id || null)}"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000007",
      "name": "Responder sucesso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 500,
        "responseBody": "={\"sent\": false, \"messageId\": $('Validar entrada').item.json.messageId, \"error\": $('Enviar via Evolution').item.json}"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000008",
      "name": "Responder erro",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 400]
    }
  ],
  "connections": {
    "Webhook do App": {
      "main": [[{ "node": "Validar entrada", "type": "main", "index": 0 }]]
    },
    "Validar entrada": {
      "main": [[{ "node": "Enviar via Evolution", "type": "main", "index": 0 }]]
    },
    "Enviar via Evolution": {
      "main": [[{ "node": "Sucesso?", "type": "main", "index": 0 }]]
    },
    "Sucesso?": {
      "main": [
        [{ "node": "PATCH messages (sucesso)", "type": "main", "index": 0 }],
        [{ "node": "PATCH messages (erro)", "type": "main", "index": 0 }]
      ]
    },
    "PATCH messages (sucesso)": {
      "main": [[{ "node": "Responder sucesso", "type": "main", "index": 0 }]]
    },
    "PATCH messages (erro)": {
      "main": [[{ "node": "Responder erro", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "v1",
  "meta": { "instanceId": "poxpur-sales-hub" },
  "tags": [{ "name": "poxpur" }, { "name": "whatsapp" }]
}
