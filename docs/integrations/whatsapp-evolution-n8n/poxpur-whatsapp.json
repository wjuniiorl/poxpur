        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ whatsapp_message_id: $json.key?.id || $json.messageId || null, metadata: { status: 'enviado', sent_via: 'evolution-n8n', evolution_response: $json } }) }}",
        "options": { "timeout": 10000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1952, 400],
      "id": "poxpur-w-012",
      "name": "PATCH status enviado",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Supabase Service Role" }
      }
