{
  "name": "Poxpur — WhatsApp + Email (consolidated)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "poxpur-inbound",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-2400, 0],
      "id": "poxpur-w-001",
      "name": "Webhook Inbound (Evolution)",
      "webhookId": "poxpur-inbound",
      "notes": "Cole esta Production URL no Evolution webhook → events: messages.upsert + messages.reaction.upsert"
    },
    {
      "parameters": {
        "jsCode": "// Extrai dados do payload Evolution: texto, mídia, reações\nconst body = $input.first().json.body || $input.first().json;\nconst data = body?.data || body;\nconst key = data?.key || {};\nconst remoteJid = key.remoteJid || data?.remoteJid || '';\nconst telefone = remoteJid.replace('@s.whatsapp.net', '').replace('@g.us', '');\nconst messageObj = data?.message || {};\nconst pushName = data?.pushName || body?.pushName || '';\nconst fromMe = key.fromMe || false;\nconst messageId = key.id || data?.key?.id || '';\n\n// === REACTION ===\nlet isReaction = false, reactionEmoji = null, reactedMessageId = null;\nif (messageObj.reactionMessage) {\n  isReaction = true;\n  reactionEmoji = messageObj.reactionMessage.text || '';\n  reactedMessageId = messageObj.reactionMessage.key?.id || null;\n}\n\n// === TEXT ===\nlet text = messageObj.conversation\n  || messageObj.extendedTextMessage?.text\n  || messageObj.buttonsResponseMessage?.selectedDisplayText\n  || messageObj.listResponseMessage?.title\n  || '';\n\n// === MEDIA ===\nlet mediaType = null, mediaUrl = null, mediaMime = null, mediaFilename = null;\nlet type = 'texto';\n\nif (messageObj.imageMessage) {\n  type = 'imagem'; mediaType = 'image';\n  mediaUrl = messageObj.imageMessage.url || data?.media?.url || '';\n  mediaMime = messageObj.imageMessage.mimetype || '';\n  text = text || messageObj.imageMessage.caption || '[imagem]';\n} else if (messageObj.videoMessage) {\n  type = 'documento'; mediaType = 'video';\n  mediaUrl = messageObj.videoMessage.url || data?.media?.url || '';\n  mediaMime = messageObj.videoMessage.mimetype || '';\n  text = text || messageObj.videoMessage.caption || '[vídeo]';\n} else if (messageObj.audioMessage) {\n  type = 'audio'; mediaType = 'audio';\n  mediaUrl = messageObj.audioMessage.url || data?.media?.url || '';\n  mediaMime = messageObj.audioMessage.mimetype || '';\n  text = text || '[áudio]';\n} else if (messageObj.documentMessage) {\n  type = 'documento'; mediaType = 'document';\n  mediaUrl = messageObj.documentMessage.url || data?.media?.url || '';\n  mediaMime = messageObj.documentMessage.mimetype || '';\n  mediaFilename = messageObj.documentMessage.fileName || '';\n  text = text || messageObj.documentMessage.caption || '[documento]';\n} else if (messageObj.locationMessage) {\n  type = 'localizacao';\n  const lat = messageObj.locationMessage.degreesLatitude, lng = messageObj.locationMessage.degreesLongitude;\n  text = `[localização: ${lat}, ${lng}]`;\n}\n\nif (!mediaUrl && data?.media?.url) mediaUrl = data.media.url;\n\nconst hasData = !isReaction && !fromMe && !!(telefone && (text || mediaUrl));\n\nreturn [{ json: {\n  telefone: '+' + telefone,\n  text, type, pushName,\n  fromMe,\n  hasData,\n  isReaction, reactionEmoji, reactedMessageId,\n  whatsappMessageId: messageId,\n  mediaType, mediaUrl, mediaMime, mediaFilename\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2160, 0],
      "id": "poxpur-w-002",
      "name": "Extrair Dados"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is-reaction",
              "leftValue": "={{ String($json.isReaction) }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1936, 0],
      "id": "poxpur-w-003",
      "name": "É reação?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/functions/v1/whatsapp-inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: 'reaction', reactedMessageId: $json.reactedMessageId, emoji: $json.reactionEmoji, fromPhone: $json.telefone }) }}",
        "options": { "timeout": 10000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1696, -128],
      "id": "poxpur-w-004",
      "name": "Edge: Reação",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Supabase Service Role" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-data",
              "leftValue": "={{ String($json.hasData) }}",
              "rightValue": "true",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-1696, 128],
      "id": "poxpur-w-005",
      "name": "Mensagem válida?"
    },
