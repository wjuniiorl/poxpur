{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "mcp__plugin_supabase_supabase__list_*",
      "mcp__plugin_supabase_supabase__get_*",
      "mcp__plugin_supabase_supabase__execute_sql",
      "mcp__plugin_supabase_supabase__list_edge_functions"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const path=process.env.CLAUDE_HOOK_FILE_PATH||''; const blocked=['.env','.env.local','.env.production','pnpm-lock.yaml','package-lock.json','yarn.lock']; if(blocked.some(b=>path.endsWith(b))){console.error('⚠️ Bloqueado: '+path+' não deve ser editado pelo Claude. Edite manualmente se necessário.'); process.exit(2);}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.CLAUDE_HOOK_FILE_PATH||''; if(/\\.(ts|tsx|css|json|md)$/.test(p)&&!p.includes('node_modules')&&!p.includes('dist/')&&!p.includes('.claude/')){const{spawnSync}=require('child_process');spawnSync('npx',['prettier','--write','--log-level','silent',p],{stdio:'ignore',shell:true,timeout:8000});}\""
          }
        ]
      }
    ]
  }
}
